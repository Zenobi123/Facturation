{
  "productName": "PRISMA GESTION",
  "version": "2.0.0",
  "identifier": "com.prismagestion.app",
  "build": {
    "frontendDist": "../facturation"
  },
  "app": {
    "windows": [
      {
        "title": "PRISMA GESTION - Logiciel de Gestion Commerciale",
        "width": 1366,
        "height": 768,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["French"],
        "installerIcon": "icons/installer-icon.ico",
        "installMode": "currentUser"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
